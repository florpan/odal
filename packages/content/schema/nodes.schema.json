{
  "$ref": "#/definitions/nodes",
  "definitions": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string",
            "default": ""
          },
          "notes": {
            "type": "string",
            "default": ""
          },
          "resource": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "gatherTime": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "gatherAmount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "spawn": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "forest"
                  },
                  "clustersPer1000Tiles": {
                    "type": "number",
                    "minimum": 0
                  },
                  "radius": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    ]
                  },
                  "perStart": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  },
                  "zone": {
                    "type": "string",
                    "enum": [
                      "anywhere",
                      "contested"
                    ],
                    "default": "anywhere"
                  }
                },
                "required": [
                  "kind",
                  "clustersPer1000Tiles",
                  "radius"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "deposit"
                  },
                  "depositsPer1000Tiles": {
                    "type": "number",
                    "minimum": 0
                  },
                  "size": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 1
                      }
                    ]
                  },
                  "perStart": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  },
                  "zone": {
                    "type": "string",
                    "enum": [
                      "anywhere",
                      "contested"
                    ],
                    "default": "anywhere"
                  }
                },
                "required": [
                  "kind",
                  "depositsPer1000Tiles",
                  "size"
                ],
                "additionalProperties": false
              }
            ]
          },
          "visual": {
            "type": "object",
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "cone",
                  "rock"
                ]
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "shape",
              "color"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "resource",
          "amount",
          "gatherTime",
          "gatherAmount",
          "spawn",
          "visual"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
