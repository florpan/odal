{
  "$ref": "#/definitions/terrain",
  "definitions": {
    "terrain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string",
            "default": ""
          },
          "notes": {
            "type": "string",
            "default": ""
          },
          "passable": {
            "type": "boolean",
            "default": true
          },
          "visual": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "height": {
                "type": "number",
                "default": 0
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "shore": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "scatter": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "density": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "scale": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "default": 1
                    },
                    "lift": {
                      "type": "number",
                      "default": 0
                    },
                    "patches": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0
                    },
                    "patchScale": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "default": 6
                    },
                    "shore": {
                      "type": "string",
                      "enum": [
                        "any",
                        "only",
                        "none"
                      ],
                      "default": "any"
                    }
                  },
                  "required": [
                    "models",
                    "density"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "color"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "visual"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
