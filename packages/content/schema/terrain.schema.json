{
  "$ref": "#/definitions/terrain",
  "definitions": {
    "terrain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string",
            "default": ""
          },
          "notes": {
            "type": "string",
            "default": ""
          },
          "passable": {
            "type": "boolean",
            "default": true
          },
          "visual": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "height": {
                "type": "number",
                "default": 0
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "color"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "visual"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
