{
  "$ref": "#/definitions/buildings",
  "definitions": {
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string",
            "default": ""
          },
          "notes": {
            "type": "string",
            "default": ""
          },
          "cost": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "default": {}
          },
          "time": {
            "type": "number",
            "minimum": 0
          },
          "requires": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "tech"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "building"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "population"
                    },
                    "min": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "type",
                    "min"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "default": []
          },
          "buildable": {
            "type": "boolean",
            "default": true
          },
          "hp": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "size": {
            "type": "object",
            "properties": {
              "radius": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              }
            },
            "additionalProperties": false,
            "default": {
              "radius": 0
            }
          },
          "pop": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "trains": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "default": []
          },
          "research": {
            "type": "boolean",
            "default": false
          },
          "upgrades": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "default": []
          },
          "dropOff": {
            "type": "boolean",
            "default": false
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "default": []
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "produces": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "interval": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "resource",
              "amount",
              "interval"
            ],
            "additionalProperties": false
          },
          "attack": {
            "type": "object",
            "properties": {
              "damage": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "range": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "attackTime": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "damage",
              "range",
              "attackTime"
            ],
            "additionalProperties": false
          },
          "passable": {
            "type": "boolean",
            "default": false
          },
          "vision": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 6
          },
          "hotkey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "visual": {
            "type": "object",
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "box",
                  "cone"
                ],
                "default": "box"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 1
              },
              "glow": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "color"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "time",
          "hp",
          "visual"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
